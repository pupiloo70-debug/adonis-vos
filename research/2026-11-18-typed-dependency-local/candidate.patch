+// 2026-11-18 additive research route: P02 typed cross-collection dependencies.
+// No source authentication or legal inference. Existing routes remain unchanged.
+export function reviewContextLinked(input) {
+  const initial = reviewContextIsolated(input);
+  const collections = ['statements', 'records', 'remedies'];
+  const held = [...initial.isolation_report.held];
+  const blocked = new Set(held.filter(x => nonempty(x.id)).map(x => `${x.collection}:${x.id}`));
+  const nodes = new Map();
+  const validRef = ref => isObj(ref) && collections.includes(ref.collection) && nonempty(ref.id)
+    && Object.keys(ref).every(key => ['collection', 'id'].includes(key));
+
+  for (const collection of collections) {
+    for (const row of input[collection]) {
+      if (!isObj(row) || !nonempty(row.id)) continue; // Already held by the existing validator.
+      const key = `${collection}:${row.id}`;
+      if (blocked.has(key)) continue;
+      if (Object.hasOwn(row, 'depends_on_items') &&
+        (!Array.isArray(row.depends_on_items) || !row.depends_on_items.every(validRef))) {
+        blocked.add(key);
+        held.push({ collection, id: row.id, reason: 'INVALID_TYPED_DEPENDENCY' });
+        continue;
+      }
+      nodes.set(key, { collection, row });
+    }
+  }
+
+  // A single graph handles intra-collection and typed cross-collection edges.
+  // Missing or held parents never turn into independently verified evidence.
+  const degrees = new Map([...nodes.keys()].map(key => [key, 0]));
+  const dependents = new Map([...nodes.keys()].map(key => [key, []]));
+  const reasons = new Map();
+  for (const [key, { collection, row }] of nodes) {
+    const deps = new Set([
+      ...(row.depends_on || []).map(id => `${collection}:${id}`),
+      ...(row.depends_on_items || []).map(ref => `${ref.collection}:${ref.id}`)
+    ]);
+    for (const dep of deps) {
+      degrees.set(key, degrees.get(key) + 1);
+      if (nodes.has(dep)) dependents.get(dep).push(key);
+      else reasons.set(key, 'DEPENDENCY_HELD_OR_MISSING');
+    }
+  }
+  const queue = [...degrees].filter(([, degree]) => degree === 0).map(([key]) => key);
+  const accepted = new Set();
+  for (let i = 0; i < queue.length; i++) {
+    const key = queue[i];
+    accepted.add(key);
+    for (const dependent of dependents.get(key)) {
+      degrees.set(dependent, degrees.get(dependent) - 1);
+      if (degrees.get(dependent) === 0) queue.push(dependent);
+    }
+  }
+  for (const [key, { collection, row }] of nodes) {
+    if (accepted.has(key)) continue;
+    held.push({ collection, id: row.id, reason: reasons.get(key) || 'DEPENDENCY_CYCLE_OR_DEPENDENT' });
+  }
+  const selected = Object.fromEntries(collections.map(collection => [collection,
+    input[collection].filter(row => isObj(row) && nonempty(row.id) && accepted.has(`${collection}:${row.id}`))]));
+  // Run the original evidence/case/privacy checks only on the proven-safe subset.
+  // Its reported source labels remain unauthenticated and remedy closure blocked.
+  const result = reviewContextIsolated({ ...input, ...selected });
+  return { ...result, isolation_report: {
+    ...result.isolation_report,
+    mode: 'ITEM_LEVEL_TYPED_LINKS_SYNTHETIC_RESEARCH',
+    held: [...held, ...result.isolation_report.held],
+    accepted_counts: Object.fromEntries(collections.map(name => [name, selected[name].length])),
+    typed_links_verified_for_scope_only: true,
+    source_truth_authenticated: false,
+    independent_valid_work_preserved: Object.values(selected).some(rows => rows.length > 0)
+  }};
+}
